{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Travel Hisab Offline",
  "version": "1.0.13",
  "identifier": "com.smcsoftwares.travelhisab.offline",
  "build": {
    "beforeDevCommand": "npm run dev:offline",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build:offline",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Travel Hisab Offline",
        "width": 900,
        "height": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {},
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": false,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
