{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "travel-accounting",
  "version": "1.0.6",
  "identifier": "com.travelaccounting.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "travel-accounting",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "endpoints": ["https://travel-accounting-alpha.vercel.app/api/updater"],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEUzMTBDOUZDQUJDNEQzODUKUldTRjA4U3IvTWtRNHlMNG5tbDNyT0JYRFNvMG16Q3dYeU82WmI3VElVc1R1STJsZ0QybWxyb3UK"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
